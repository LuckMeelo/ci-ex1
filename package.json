{
  "name": "ci-ex1",
  "version": "1.0.0",
  "description": "Simple exercise to test CI/CD pipeline",
  "main": "app.ts",
  "scripts": {
    "build": "npm install && npm run lint && npm run prettier:check && npm run test && npm run sass && tsc",
    "start": "node ./dist/app.js",
    "dev": "nodemon ./dist/app.js",
    "ts:watch": "tsc --watch",
    "sass": "sass ./src/styles:./public/css",
    "sass:watch": "sass --watch ./src/styles:./public/css",
    "prettier:fix": "prettier --write ./src/**/*.ts",
    "prettier:check": "prettier --check ./src/**/*.ts",
    "lint": "eslint ./src --ext .ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckMeelo/ci-ex1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LuckMeelo/ci-ex1/issues"
  },
  "homepage": "https://github.com/LuckMeelo/ci-ex1#readme",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "sass": "^1.86.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "http": "^0.0.1-security"
  }
}
